{
  "name": "clankers",
  "version": "0.1.0",
  "private": true,
  "description": "Agent plugin collection.",
  "license": "MIT",
  "keywords": [
    "pi-package"
  ],
  "scripts": {
    "check": "pnpm lint:ts && pnpm lint:py && pnpm lint:workflows && pnpm test:ts:uncovered && pnpm coverage:ts && pnpm test:py",
    "test": "pnpm test:ts && pnpm test:py:fast",
    "test:ts": "vitest run",
    "test:ts:reuse": "vitest run --maxWorkers=1 --no-isolate --sequence.seed=1",
    "coverage:ts": "pnpm --recursive --if-present run coverage",
    "test:ts:uncovered": "vitest run --project '!output-styles'",
    "test:py": "uv run --no-project --isolated --python 3.14 python plugins/project-advisor/skills/to-prd/tests/run_parallel.py",
    "test:py:fast": "uv run --no-project --isolated --python 3.14 python plugins/project-advisor/skills/to-prd/tests/run_parallel.py --fast",
    "lint:ts": "pnpm --recursive run lint && pnpm --recursive run format:check && pnpm --recursive run typecheck",
    "lint:py": "cd plugins/project-advisor/skills/to-prd && uvx ruff@0.16.9 check . && uvx ruff@0.16.9 format --check .",
    "lint:workflows": "uvx --from actionlint-py==1.7.12.25 actionlint -ignore 'unexpected key \"queue\" for \"concurrency\" section' && uvx zizmor@1.30.1 .github"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.90.0",
    "vitest": "^5.0.5"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    }
  },
  "pi": {
    "extensions": [
      "./plugins/output-styles/index.ts",
      "./plugins/security-guard/index.ts",
      "./plugins/insomniac/index.ts"
    ]
  },
  "files": [
    "README.md",
    "LICENSE",
    "plugins/output-styles/index.ts",
    "plugins/output-styles/src/**",
    "plugins/output-styles/styles/**",
    "plugins/output-styles/examples/**",
    "plugins/output-styles/tsconfig.json",
    "plugins/output-styles/tsconfig.build.json",
    "plugins/output-styles/package.json",
    "plugins/output-styles/README.md",
    "plugins/output-styles/LICENSE",
    "plugins/security-guard/index.ts",
    "plugins/security-guard/src/**",
    "plugins/security-guard/package.json",
    "plugins/security-guard/README.md",
    "plugins/insomniac/index.ts",
    "plugins/insomniac/src/**",
    "plugins/insomniac/package.json",
    "plugins/insomniac/README.md"
  ],
  "packageManager": "pnpm@12.16.1+sha512.091d1dee7927575661b25dab3c2ae31cafc1c54d6b71ed6a6600cf0c1cb10434a447eae14015f1b23e2e6bedeed79df94a932e2164d2832280dce3fb32f656d1",
  "dependencies": {
    "proper-lockfile": "^4.1.2",
    "yaml": "^2.9.1"
  }
}
